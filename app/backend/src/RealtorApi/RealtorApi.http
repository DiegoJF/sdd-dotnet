# ─────────────────────────────────────────────
# GET /api/properties/{id} — Consulta de propiedad por id
# ─────────────────────────────────────────────

@propertyWithImageId = a1f0e2d4-7c81-4d12-9e61-0b7f0b1a1001
@propertyWithoutImageId = 00000000-0000-0000-0000-000000000001

### Escenario 1: 200 OK — propiedad existente con imagen

GET {{RealtorApi_HostAddress}}/api/properties/{{propertyWithImageId}}
Accept: application/json

### Escenario 2: 200 OK — propiedad existente sin imagen
# Reemplazar propertyWithoutImageId por un id real sin imagen (por ejemplo, creado con el POST sin image).

GET {{RealtorApi_HostAddress}}/api/properties/{{propertyWithoutImageId}}
Accept: application/json

### Escenario 3: 400 Bad Request — id inválido

GET {{RealtorApi_HostAddress}}/api/properties/not-a-uuid
Accept: application/json

### Escenario 4: 404 Not Found — id inexistente

GET {{RealtorApi_HostAddress}}/api/properties/00000000-0000-0000-0000-000000000000
Accept: application/json

# Expected (ProblemDetails):
# {
#   "type": "about:blank",
#   "title": "Propiedad no encontrada.",
#   "status": 404,
#   "detail": "No existe una propiedad con el id proporcionado."
# }

